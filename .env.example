# Firebase Admin (server). Hodnoty zo Service Account JSON (Firebase konzola > Project settings > Service accounts).
# NIKDY necommituj skutočný .env.local do gitu.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Privátny kľúč vlož v úvodzovkách a s \n namiesto nových riadkov.
FIREBASE_PRIVATE_KEY=

# Povolená doména školského e-mailu (bez @), napr. skola.sk. Registrácia mimo nej sa odmietne.
SCHOOL_EMAIL_DOMAIN=

# Firebase klient (tieto hodnoty smú byť verejné, sú v konfigurácii webovej appky).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tajný reťazec, ktorým Vercel Cron overuje volanie /api/cron/*. Vymysli dlhý náhodný reťazec.
CRON_SECRET=
